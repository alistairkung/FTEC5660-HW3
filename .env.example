# Only DeepSeek is needed for normal homework execution.
DEEPSEEK_API_KEY=

# Optional: leave blank to disable tracing automatically.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_TIMEOUT=5

# Optional smoke test makes one paid DeepSeek call only when explicitly enabled.
LANGFUSE_LIVE_SMOKE=false
